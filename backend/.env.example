# Copy this file to .env and adjust as needed.

# Port the API server listens on
PORT=4000

# Where the React frontend runs (for CORS). Add more origins comma-separated if needed.
FRONTEND_ORIGIN=http://localhost:5173

# Secret used to sign admin login tokens — change this to a long random string in production.
JWT_SECRET=change-this-to-a-long-random-secret

# Default admin account. Created automatically the first time the server starts
# (or when you run `npm run seed`). Change the password after first login is not
# built into the UI yet, so for now just edit these values and re-seed if needed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Set to "true" the first time you run `npm run seed` if you want the seeder to try
# downloading the original Unsplash photos used in the demo packages into
# /uploads/seed so the database references local files instead of external URLs.
# Requires normal internet access on the machine running the seed script.
DOWNLOAD_SEED_IMAGES=true
